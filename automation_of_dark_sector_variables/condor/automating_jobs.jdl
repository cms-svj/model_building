universe             = vanilla
executable           = run_job.sh
transfer_input_files = run_job.sh

+ApptainerImage = "/cvmfs/singularity.opensciencegrid.org/opensciencegrid/osgvo-el9:latest"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

output = logs/condor_$(Cluster)_$(Process)_rinv-$(rinv).out
error  = logs/condor_$(Cluster)_$(Process)_rinv-$(rinv).err
log    = logs/condor_$(Cluster)_rinv-$(rinv).log

use_x509userproxy = True
x509userproxy     = $ENV(X509_USER_PROXY)

# PROJECT_NAME must match the repo folder name; EOS_USER is taken from whoever submits
# environment = "PROJECT_NAME=model_building EOS_USER=$ENV(USER)"
environment = "PROJECT_NAME=model_building EOS_USER=$ENV(USER) EOS_AREA=model_building_fork"



# add $(rinv) as 5th arg
# options for models are cms, snowmass, both, master_snowmass, master_cms
arguments = j$(Cluster).$(Process) master_cms 20 $$([100000 + ProcId]) $(rinv)

request_memory = 8GB
request_disk   = 8GB

# queue scan points
#queue rinv in 0.1, 0.3, 0.5, 0.7, 0.9 
#queue rinv in 0.55,0.6,0.65,0.7,0.75,0.8,0.85,0.9,0.95
queue rinv in 0.1